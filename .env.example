# Copy to .env.local for development.
# AUTH_SECRET signs session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Postgres connection string. The bundled docker-compose.dev.yml ships these
# defaults; override for hosted (Neon) or self-host installs.
DATABASE_URL=postgres://mainichi:mainichi@localhost:5432/mainichi

# Public origin used to build links in transactional emails (password reset).
# Falls back to http://localhost:3000 in development.
APP_URL=http://localhost:3000

# Email provider for transactional mail (currently: password reset).
# Options: "resend" (recommended on Vercel), "smtp" (recommended for
# self-host), or "log" (writes the email payload to stdout — dev only).
EMAIL_PROVIDER=log
EMAIL_FROM="Mainichi <noreply@example.com>"

# Required when EMAIL_PROVIDER=resend. Get a key at https://resend.com.
RESEND_API_KEY=

# Required when EMAIL_PROVIDER=smtp. Use any SMTP relay (Postmark, SES,
# Fastmail, mailpit for local). SMTP_PORT defaults to 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set SMTP_SECURE=true for implicit TLS on port 465.
SMTP_SECURE=false
